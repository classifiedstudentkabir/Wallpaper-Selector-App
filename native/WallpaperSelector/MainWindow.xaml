<Window
    x:Class="WallpaperSelector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Wallpaper Selector">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Mica Title Bar (mirrors the web prototype TitleBar component) -->
        <Grid x:Name="AppTitleBarRoot" Grid.Row="0"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App identity -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <FontIcon Glyph="&#xE91B;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Wallpaper Selector" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="13" FontWeight="SemiBold" />
                <Border Background="{StaticResource AccentBrush}" Opacity="0.15" CornerRadius="4"
                        Margin="12,0,0,0" Padding="6,2">
                    <TextBlock Text="WinUI 3" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>

            <!-- Hotkey status + quick picker trigger -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="HotkeyStatusText" Text="Global hotkeys: …" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                        Margin="16,0,0,0" Padding="12,4" FontSize="11"
                        Click="OnQuickPickerClick" Content="Win + Alt + W" />
            </StackPanel>

            <!-- Window caption buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button AutomationProperties.Name="Minimize"
                        Click="OnMinimizeClick" Padding="12,8">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button AutomationProperties.Name="Maximize"
                        Click="OnMaximizeClick" Padding="12,8">
                    <FontIcon x:Name="MaximizeGlyph" Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button AutomationProperties.Name="Close"
                        Click="OnCloseClick" Padding="12,8">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- WinUI 3 NavigationView (mirrors the web prototype NavigationSidebar) -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home (6 Slots)" Icon="Home" Tag="Home" />
                <NavigationViewItem Content="Global Hotkeys" Icon="Keyboard" Tag="Hotkeys" />
                <NavigationViewItem Content="Auto-Rotate" Icon="Clock" Tag="AutoRotate" />
                <NavigationViewItem Content="About" Icon="Info" Tag="About" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
