<Page
    x:Class="WallpaperSelector.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="24,16,24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="16">

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE91B;" FontSize="34"
                              Foreground="{StaticResource AccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Wallpaper Selector" FontSize="18" FontWeight="Bold" />
                            <Border Background="{StaticResource AccentBrush}" Opacity="0.15" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="v1.2.0 · WinUI 3" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Lightweight 6-slot wallpaper management with global hotkeys for Windows 10 &amp; 11." />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="2" Content="GitHub / main"
                                      VerticalAlignment="Center"
                                      NavigateUri="https://github.com/classifiedstudentkabir/Wallpaper-Selector-App" />
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Technical Stack" FontSize="14" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,8"
                                Background="{StaticResource AccentBrush}" Opacity="0.15">
                            <TextBlock Text=".NET 8.0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,8"
                                Background="{StaticResource AccentBrush}" Opacity="0.15">
                            <TextBlock Text="Windows App SDK 1.5 (WinUI 3)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,8"
                                Background="{StaticResource AccentBrush}" Opacity="0.15">
                            <TextBlock Text="MVVM · CommunityToolkit.Mvvm" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,8"
                                Background="{StaticResource AccentBrush}" Opacity="0.15">
                            <TextBlock Text="Win32 + COM" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Implemented Features" FontSize="14" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                    <ItemsControl x:Name="FeaturesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Project Handoff" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="This native application implements the behavior specified by the web prototype at the repository root (kept as the UI reference, not deleted). Global hotkeys, drag-and-drop slot reordering, deleted-source resilience and corrupted-settings auto-repair are covered by the xUnit suite in WallpaperSelector.Tests — see docs/NATIVE_PORTING_GUIDE.md for the full mapping and the remaining work list." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
