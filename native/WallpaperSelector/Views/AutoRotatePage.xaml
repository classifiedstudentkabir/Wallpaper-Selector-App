<Page
    x:Class="WallpaperSelector.Views.AutoRotatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="24,16,24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Auto-Rotate Wallpaper Engine" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

            <!-- Master toggle -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Rotate automatically" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Advance through the six slots on a fixed interval."
                                   FontSize="11" Margin="0,2,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="RunningSwitch"
                                  Toggled="OnRunningToggled" />
                </Grid>
            </Border>

            <!-- Interval -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Interval" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ComboBox x:Name="IntervalCombo" SelectionChanged="OnIntervalChanged">
                        <ComboBoxItem Content="10 seconds (demo)" />
                        <ComboBoxItem Content="1 minute" />
                        <ComboBoxItem Content="5 minutes" />
                        <ComboBoxItem Content="15 minutes" />
                        <ComboBoxItem Content="30 minutes" />
                        <ComboBoxItem Content="1 hour" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Shuffle (random slot each tick)" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ShuffleSwitch"
                                      Toggled="OnShuffleToggled" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Next change in" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="CountdownText" Text="—" FontSize="22" FontFamily="Consolas"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Rotate Now" VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}" Click="OnRotateNowClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Configuration persists to autorotate.json in AppData. Day/Night dynamic switching (DaySlot/NightSlot) is stored and can be wired to a scheduled switcher; see docs/NATIVE_PORTING_GUIDE.md." />
        </StackPanel>
    </ScrollViewer>
</Page>
