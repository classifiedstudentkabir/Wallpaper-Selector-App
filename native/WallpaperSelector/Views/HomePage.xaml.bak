<Page
    x:Class="WallpaperSelector.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:WallpaperSelector.Core.Models"
    mc:Ignorable="d"
    Title="Home">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + status line (mirrors the web prototype hero banner) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Wallpaper Slots (1–6)" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12" Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="OnAddImageClick" Content="+ Add Image" Margin="0,0,8,0" />
                <Button Click="OnExportClick" Content="Export" Margin="0,0,8,0" />
                <Button Click="OnImportClick" Content="Import" />
            </StackPanel>
        </Grid>

        <!-- Reorder hint -->
        <TextBlock Grid.Row="1" Margin="0,0,0,12" FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Drag a card to reorder (slot numbers 1–6 re-index automatically) · Win+Alt+1..6 applies a slot directly." />

        <!-- Six-slot grid -->
        <ListView Grid.Row="2" x:Name="SlotsList"
                  ItemsSource="{Binding Slots}"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <!--
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <!-- 
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:WallpaperSlot">
                    <Border Width="300" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource ActiveSlotBorder}}"
                            BorderThickness="1.5"
                            PointerPressed="OnCardPointerPressed"
                            PointerMoved="OnCardPointerMoved"
                            PointerReleased="OnCardPointerReleased">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="110" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Thumbnail (cached thumbnail survives source deletion) -->
                            <Grid Grid.Row="0">
                                <Image Source="{x:Bind ThumbnailPath, Mode=OneWay}"
                                       Stretch="UniformToFill" />

                                <!-- Slot number badge -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                        Background="#CC000000" CornerRadius="6" Padding="7,2">
                                    <TextBlock Text="{x:Bind SlotNumber, Mode=OneWay}" FontSize="12" FontWeight="Bold" />
                                </Border>

                                <!-- Edge case: source file deleted/moved -->
                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                        Background="#E67A4D00"
                                        Visibility="{x:Bind IsSourceMissing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Padding="8,4">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#FFFFFF" />
                                        <TextBlock Text="Source file missing — re-import to apply"
                                                   FontSize="11" Foreground="#FFFFFF" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Title + metadata -->
                            <StackPanel Grid.Row="1" Margin="12,8,12,0">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{x:Bind FitMode, Mode=OneWay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="  ·  " FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind FileSizeBytes, Mode=OneWay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Per-slot actions -->
                            <Grid Grid.Row="2" Margin="12,10,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding DataContext.MoveSlotUpCommand, ElementName=SlotsList}"
                                        CommandParameter="{Binding}"
                                        Content="↑" ToolTipService.ToolTip="Move up (reorder)" />
                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.MoveSlotDownCommand, ElementName=SlotsList}"
                                        CommandParameter="{Binding}"
                                        Content="↓" ToolTipService.ToolTip="Move down (reorder)" Margin="4,0,0,0" />

                                <Button Grid.Column="2"
                                        Command="{Binding DataContext.ClearSlotCommand, ElementName=SlotsList}"
                                        CommandParameter="{Binding}"
                                        Content="Clear" ToolTipService.ToolTip="Clear slot"
                                        HorizontalAlignment="Right" Margin="8,0,8,0" />
                                <Button Grid.Column="3"
                                        Command="{Binding DataContext.ApplyWallpaperCommand, ElementName=SlotsList}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="Apply" ToolTipService.ToolTip="Apply as desktop background"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            -->
        </ListView>
    </Grid>
</Page>
