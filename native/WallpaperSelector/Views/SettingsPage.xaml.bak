<Page
    x:Class="WallpaperSelector.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <ScrollViewer Margin="24,16,24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">

            <StackPanel>
                <TextBlock Text="Application Settings" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Text="Settings loaded." FontSize="12" Margin="0,4,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Personalization -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Personalization & Material Themes" FontSize="14" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Theme" FontSize="13" VerticalAlignment="Center"
                                   MinWidth="140" />
                        <ComboBox Grid.Column="1" x:Name="ThemeCombo" SelectionChanged="OnSelectionChanged"
                                  MinWidth="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="System" />
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Accent color" FontSize="13" VerticalAlignment="Center"
                                   MinWidth="140" />
                        <ComboBox Grid.Column="1" x:Name="AccentCombo" SelectionChanged="OnSelectionChanged"
                                  MinWidth="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Windows Blue (#0078D4)" />
                            <ComboBoxItem Content="Cyan Ice (#60CDFF)" />
                            <ComboBoxItem Content="Royal Purple (#9B51E0)" />
                            <ComboBoxItem Content="Forest Green (#107C41)" />
                            <ComboBoxItem Content="Warm Amber (#FF8C00)" />
                            <ComboBoxItem Content="Crimson Red (#FF4343)" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behavior toggles -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="System Integration" FontSize="14" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Launch at Windows startup (HKCU Run key)" FontSize="13"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="StartupSwitch" Toggled="OnControlChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Minimize to system tray" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="TraySwitch" Toggled="OnControlChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Sound effects (slot switch / UI cues)" FontSize="13"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SoundSwitch" Toggled="OnControlChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Confirm before clearing a slot" FontSize="13"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ConfirmSwitch" Toggled="OnControlChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Local Storage & Cache" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="CachePathText" FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear Thumbnail Cache" Click="OnClearCacheClick" />
                        <Button Content="Export Settings JSON" Click="OnExportClick" />
                        <Button Content="Reset to Defaults" Click="OnResetClick" />
                    </StackPanel>
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                            Content="Save Settings" Click="OnSaveClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
